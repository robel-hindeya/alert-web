# ========================================================
# ALERT Hospital Management System - Environment Configuration
# ========================================================

# MySQL Database Configuration
# Set these according to your local MySQL server (XAMPP, WAMP, Docker, or native MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=alert_hospital

# Alternatively, you can specify a full MySQL connection URL:
# DATABASE_URL=mysql://root:password@localhost:3306/alert_hospital
