# ========================================================
# ALERT Hospital Management System - Environment Configuration
# ========================================================

# Supabase Project Configuration
# Retrieve these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Compatible Next.js / framework prefixes (optional, supported interchangeably)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Side Supabase Service Role Key (NEVER commit to version control or expose to client)
# Allows administrative hospital backend API operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
